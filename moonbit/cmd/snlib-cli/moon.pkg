import {
  "ruseel/snlib-cli/snlib/cli",
  "ruseel/snlib-cli/snlib/store",
  "ruseel/snlib-cli/snlib/http_session",
  "ruseel/snlib-cli/snlib/model",
  "ruseel/snlib-cli/snlib/remote",
  "moonbitlang/core/ref",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-lcurl" } },
)
